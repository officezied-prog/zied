# ── Core ────────────────────────────────────────────────────────────────────
SS_ENVIRONMENT=local
SS_DEBUG=false

# ── Database ────────────────────────────────────────────────────────────────
# The login role must be a MEMBER of `authenticated` and must NOT own the
# tables, otherwise row-level security is bypassed.
SS_DATABASE_URL=postgresql+asyncpg://smartstylist_app:change-me@localhost:5432/smartstylist
SS_DB_REQUEST_ROLE=authenticated

# ── Auth ────────────────────────────────────────────────────────────────────
SS_JWT_ALGORITHM=RS256
SS_JWT_PUBLIC_KEY=
SS_JWT_ISSUER=https://<project>.supabase.co/auth/v1
SS_JWT_AUDIENCE=authenticated
# HS256 + this secret are for local development only.
SS_JWT_SECRET=dev-only-change-me-at-least-32-bytes

# ── Storage ─────────────────────────────────────────────────────────────────
SS_STORAGE_BACKEND=local           # local | s3
SS_STORAGE_LOCAL_ROOT=/tmp/smartstylist-storage
SS_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/_storage
SS_S3_REGION=eu-central-1
SS_S3_ENDPOINT_URL=

# ── Vision ──────────────────────────────────────────────────────────────────
SS_SEGMENTER=stub                  # stub | yolo
SS_YOLO_WEIGHTS=yolo11x-seg.pt
SS_AUTO_ACCEPT_CONFIDENCE=0.60
SS_MIN_AREA_RATIO=0.02
SS_PHASH_DUPLICATE_DISTANCE=6
SS_MAX_IMAGE_SIDE=2048

# ── Worker ──────────────────────────────────────────────────────────────────
SS_WORKER_BATCH_SIZE=8
SS_WORKER_POLL_INTERVAL_S=1.0
SS_WORKER_CLAIM_TTL_S=600
SS_WORKER_MAX_ATTEMPTS=3
